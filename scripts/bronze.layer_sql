IF OBJECT_ID('bronze.patients', 'U') IS NOT NULL
DROP TABLE bronze.patients;

CREATE TABLE bronze.patients (
patient_id NVARCHAR(MAX),
age	NVARCHAR(MAX),
gender	NVARCHAR(MAX),
comorbidity_index NVARCHAR(MAX),
admission_type NVARCHAR(MAX),
baseline_risk_score NVARCHAR(MAX),
los_hours	NVARCHAR(MAX),
deterioration_event NVARCHAR(MAX),
deterioration_within_12h_from_admission NVARCHAR(MAX),
deterioration_hour NVARCHAR(MAX)
);

IF OBJECT_ID('bronze.vitals_timeseries', 'U') IS NOT NULL
DROP TABLE bronze.vitals_timeseries;

CREATE TABLE bronze.vitals_timeseries (
patient_id NVARCHAR(MAX),
hour_from_admission NVARCHAR(MAX),
heart_rate	NVARCHAR(MAX),
respiratory_rate NVARCHAR(MAX),	
spo2_pct NVARCHAR(MAX),
temperature_c	NVARCHAR(MAX),
systolic_bp NVARCHAR(MAX),
diastolic_bp	NVARCHAR(MAX),
oxygen_device	NVARCHAR(MAX),
oxygen_flow NVARCHAR(MAX),
mobility_score NVARCHAR(MAX),
nurse_alert NVARCHAR(MAX)
);


IF OBJECT_ID('bronze.labs_timeseries', 'U') IS NOT NULL
DROP TABLE bronze.labs_timeseries;

CREATE TABLE bronze.labs_timeseries (
patient_id NVARCHAR(MAX),
hour_from_admission NVARCHAR(MAX),
wbc_count NVARCHAR(MAX),
lactate NVARCHAR(MAX),
creatinine NVARCHAR(MAX),
crp_level NVARCHAR(MAX),
hemoglobin NVARCHAR(MAX),
sepsis_risk_score NVARCHAR(MAX)
);


----------------------------------------------------------------------------------------------

-- Insert the data into the bronze layer

CREATE OR ALTER PROCEDURE bronze.hospital_bronze AS 
BEGIN
    DECLARE @start_time DATETIME, @end_time DATETIME, @batch_start_time DATETIME, @batch_end_time DATETIME;
	BEGIN TRY
	      SET @batch_start_time = GETDATE();
		PRINT '=============================================';
		PRINT 'Loading Bronze Layer'
		PRINT '=============================================';

		PRINT '---------------------------------------------';
		PRINT 'Loading Patients Table';
		PRINT '---------------------------------------------';

		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.patients';
		TRUNCATE TABLE bronze.patients;

		PRINT '>> Inserting Data Into: bronze.patients';
		BULK INSERT bronze.patients
		FROM 'C:\SQL data\patients.csv'
		WITH ( 
		      FORMAT = 'CSV',
			  FIRSTROW = 2,
			  FIELDTERMINATOR = ',',
			  ROWTERMINATOR = '0x0a',
			  TABLOCK 
		);	
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + 'seconds';
		PRINT '>> -------------';

		
		PRINT '---------------------------------------------';
		PRINT 'Loading vitals_timeseries Table';
		PRINT '---------------------------------------------';

		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.vitals_timeseries';
		TRUNCATE TABLE bronze.vitals_timeseries;

		PRINT '>> Inserting Data Into: bronze.vitals_timeseries';
		BULK INSERT bronze.vitals_timeseries
		FROM 'C:\SQL data\vitals_timeseries.csv'
		WITH ( 
		      FORMAT = 'CSV',
			  FIRSTROW = 2,
			  FIELDTERMINATOR = ',',
			  ROWTERMINATOR = '0x0a',
			  TABLOCK 
		);	
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + 'seconds';
		PRINT '>> -------------';
		
		PRINT '---------------------------------------------';
		PRINT 'Loading labs_timeseries Table';
		PRINT '---------------------------------------------';

		SET @start_time = GETDATE();
		PRINT '>> Truncating Table: bronze.labs_timeseries';
		TRUNCATE TABLE bronze.labs_timeseries;

		PRINT '>> Inserting Data Into: bronze.labs_timeseries';
		BULK INSERT bronze.labs_timeseries
		FROM 'C:\SQL data\labs_timeseries.csv'
		WITH ( 
		      FORMAT = 'CSV',
			  FIRSTROW = 2,
			  FIELDTERMINATOR = ',',
			  ROWTERMINATOR = '0x0a',
			  KEEPNULLS,
			  TABLOCK 
		);	
		SET @end_time = GETDATE();
		PRINT '>> Load Duration: ' + CAST(DATEDIFF(second, @start_time, @end_time) AS NVARCHAR) + 'seconds';
		PRINT '>> -------------';

		SET @batch_end_time = GETDATE();
		PRINT '=========================================='
		PRINT ' Loading Bronze Layer Is Completed';
		PRINT '     - Total Load Duration: ' + CAST(DATEDIFF(second, @batch_start_time, @batch_end_time) AS NVARCHAR) + 'seconds';
		PRINT '=========================================='
	END TRY
	BEGIN CATCH
	      PRINT '============================================'
		  PRINT 'ERROR OCCURED DURING LOADING BRONZE LAYER'
		  PRINT 'Error Message' + ERROR_MESSAGE();
		  PRINT 'Error MESSAGE' + CAST(ERROR_NUMBER() AS NVARCHAR);
		  PRINT 'Error MESSAGE' + CAST(ERROR_STATE() AS NVARCHAR);
		  PRINT '============================================'
	END CATCH
END

EXEC bronze.hospital_bronze;
