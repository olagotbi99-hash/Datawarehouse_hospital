/*
=============================================================
Create Database and Schemas
=============================================================
Script Purpose:
    This script creates a new database named 'Hospitalclinicaldeterioration' after checking if it already exists. 
    If the database exists, it is dropped and recreated. Additionally, the script sets up three schemas 
    within the database: 'bronze', 'silver', and 'gold'.
	
WARNING:
    Running this script will drop the entire 'Hospitalclinicaldeterioration' database if it exists. 
    All data in the database will be permanently deleted. Proceed with caution 
    and ensure you have proper backups before running this script.
*/



USE master;

-- Drop and recreate the 'Hospitalclinicaldeterioration' database
  
IF EXISTS (SELECT 1 FROM sys.databases WHERE name = 'Hospitalclinicaldeterioration')
BEGIN
     ALTER DATABASE Hospitalclinicaldeterioration SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
     DROP DATABASE Hospitalclinicaldeterioration;
END;
GO

-- Create the 'Hospitalclinicaldeterioration' database
  
CREATE DATABASE Hospitalclinicaldeterioration;

USE Hospitalclinicaldeterioration;

-- Create Schemas
  
CREATE SCHEMA bronze;
GO
CREATE SCHEMA silver;
GO
CREATE SCHEMA gold;
GO
